{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Formal agent task outcome",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{32}$"
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "step": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "boundary_confirmation": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "1.0"
    },
    "role": {
      "enum": [
        "qa-step-executor",
        "qa-contract-author",
        "qa-verification",
        "qa-architecture-reviewer"
      ]
    },
    "provider": {
      "enum": [
        "codex",
        "antigravity",
        "claude"
      ]
    },
    "status": {
      "enum": [
        "completed",
        "blocked",
        "failed",
        "not_run"
      ]
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pending_approvals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "remaining_work": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "argv": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT RUN"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "argv",
          "cwd",
          "exit_code",
          "status",
          "evidence"
        ]
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT RUN"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "check_id",
          "status",
          "evidence"
        ]
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "recommendation": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "severity",
          "location",
          "evidence",
          "recommendation"
        ]
      }
    }
  },
  "required": [
    "task_id",
    "actor",
    "step",
    "summary",
    "boundary_confirmation",
    "schema_version",
    "role",
    "provider",
    "status",
    "deliverables",
    "blockers",
    "pending_approvals",
    "remaining_work",
    "commands",
    "checks"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "role": {
            "const": "qa-architecture-reviewer"
          }
        }
      },
      "then": {
        "required": [
          "findings"
        ]
      }
    }
  ]
}
