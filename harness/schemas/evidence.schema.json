{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Development verification evidence (not QA results)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "step",
    "provider",
    "owner",
    "check_id",
    "command",
    "cwd",
    "started_at",
    "finished_at",
    "exit_code",
    "status",
    "log",
    "log_sha256",
    "source_sha256",
    "git",
    "instrumentation",
    "signature"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "step": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "enum": [
        "codex",
        "claude",
        "antigravity"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "check_id": {
      "type": "string",
      "minLength": 1
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cwd": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string"
    },
    "finished_at": {
      "type": "string"
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT RUN"
      ]
    },
    "log": {
      "type": "string",
      "minLength": 1
    },
    "log_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "git": {
      "type": "object"
    },
    "instrumentation": {
      "const": "subprocess-capture"
    },
    "signature": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 0
          }
        }
      }
    }
  ]
}
