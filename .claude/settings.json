{
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Bash(git tag*)",
      "Bash(git push*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.venv/bin/python \"${CLAUDE_PROJECT_DIR}\"/harness/scripts/claude_hook.py SessionStart",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.venv/bin/python \"${CLAUDE_PROJECT_DIR}\"/harness/scripts/claude_hook.py PreToolUse",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.venv/bin/python \"${CLAUDE_PROJECT_DIR}\"/harness/scripts/claude_hook.py PostToolUse",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.venv/bin/python \"${CLAUDE_PROJECT_DIR}\"/harness/scripts/claude_hook.py Stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
